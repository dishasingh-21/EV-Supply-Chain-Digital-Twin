# Copy this file to .env and fill in real values.

# MongoDB connection string. Use a local mongod, Docker Compose (see docker-compose.yml),
# or a MongoDB Atlas cluster.
MONGO_URI=mongodb://127.0.0.1:27017/ev_route_optimizer

# Port the Express API listens on.
PORT=5000

# Max EV range in km used by the A* planner as the "full tank" reference
# (matches MAX_RANGE in the original client-side script).
MAX_RANGE_KM=400

# Average driving speed (km/h) and charging stop duration (minutes) used for ETA estimates.
AVG_SPEED_KMH=60
CHARGE_STOP_MINUTES=30

# Allowed CORS origin for the frontend (set to your deployed frontend URL in production).
CLIENT_ORIGIN=http://localhost:5500

# Required to use POST /api/stations (sent as x-api-key header). Leave unset to disable writes.
ADMIN_API_KEY=

NODE_ENV=development
